{
  "name": "msgbusviz",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/protocol",
    "packages/core",
    "packages/viewer",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/binding-darwin-arm64": "^1.2.15",
    "@rollup/rollup-darwin-arm64": "^4.65.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.13.0",
    "lightningcss-darwin-arm64": "^1.33.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.65.0"
  }
}
